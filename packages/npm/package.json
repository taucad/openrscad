{
  "name": "@taulabs/openrscad-engine",
  "version": "0.11.0-beta.3",
  "description": "Tau's fork of the OpenRSCAD geometry engine, compiled to WebAssembly — parse .scad source and render solid 3D meshes in the browser or Node. Adds an authored-scene GLB/3MF export path with source-derived feature edges; tracks upstream.",
  "type": "module",
  "license": "Apache-2.0 OR MIT",
  "author": "Matt Hova",
  "homepage": "https://github.com/taucad/openrscad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/openrscad.git",
    "directory": "packages/npm"
  },
  "bugs": {
    "url": "https://github.com/taucad/openrscad/issues"
  },
  "keywords": [
    "openscad",
    "scad",
    "cad",
    "wasm",
    "webassembly",
    "geometry",
    "csg",
    "3d",
    "mesh",
    "openrscad",
    "fork"
  ],
  "types": "./dist/browser.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js",
        "require": "./pkg/node/openrscad.js"
      },
      "default": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./web": {
      "types": "./pkg/web/openrscad.d.ts",
      "default": "./pkg/web/openrscad.js"
    },
    "./node": {
      "types": "./pkg/node/openrscad.d.ts",
      "default": "./pkg/node/openrscad.js"
    },
    "./openrscad_bg.wasm": "./pkg/web/openrscad_bg.wasm",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./pkg/*/openrscad.js",
    "./dist/*.js"
  ],
  "files": [
    "dist",
    "!dist/native/*.node",
    "pkg/web",
    "pkg/node",
    "examples",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run build:wasm && npm run build:addon && npm run build:facade",
    "build:wasm": "wasm-pack build ../../crates/openrscad-wasm --release --target web --out-dir \"$PWD/pkg/web\" --out-name openrscad && wasm-pack build ../../crates/openrscad-wasm --release --target nodejs --out-dir \"$PWD/pkg/node\" --out-name openrscad && rm -f pkg/web/.gitignore pkg/node/.gitignore",
    "build:wasm:profile": "wasm-pack build ../../crates/openrscad-wasm --release --target web --out-dir \"$PWD/pkg/web\" --out-name openrscad -- --features benchmark-profile && wasm-pack build ../../crates/openrscad-wasm --release --target nodejs --out-dir \"$PWD/pkg/node\" --out-name openrscad -- --features benchmark-profile && rm -f pkg/web/.gitignore pkg/node/.gitignore",
    "build:addon": "napi build --platform --release --esm --js index.js --dts index.d.ts --output-dir ./src/native --manifest-path ../../crates/openrscad-napi/Cargo.toml",
    "build:facade": "tsc -p tsconfig.json && node scripts/copy-native.mjs",
    "test": "npm run build:facade && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6",
    "typescript": "^5.5.3"
  },
  "contributors": [
    "Richard Fontein (Tau)"
  ],
  "napi": {
    "binaryName": "openrscad",
    "packageName": "@taulabs/openrscad-engine",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  }
}
